# Parametri dell'estensione Trigger Email from Firestore (firebase/firestore-send-email), con segnaposto.
# Il file vero, extensions/firestore-send-email.env, non è in git: contiene l'indirizzo mittente, il login SMTP e
# il numero del progetto. Lo crea `npx firebase ext:install firebase/firestore-send-email --project <id>` oppure si
# copia questo file e si sostituiscono i valori tra parentesi angolari (vedi docs/DEPLOY.md, punto 10).
# La chiave SMTP non va mai scritta qui: la inserisce `npx firebase ext:configure firestore-send-email` e finisce
# in Secret Manager; la riga SMTP_PASSWORD è solo il riferimento al secret.
AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=europe-west12
DEFAULT_FROM=<indirizzo-mittente-verificato-dal-fornitore-smtp>
firebaseextensions.v1beta.function/location=europe-west12
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=false
SMTP_CONNECTION_URI=smtp://<login-smtp-percent-encoded>@<server-smtp>:587
SMTP_PASSWORD=projects/<numero-progetto>/secrets/ext-firestore-send-email-SMTP_PASSWORD/versions/1
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
