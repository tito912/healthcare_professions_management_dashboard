{
  "name": "@turni/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "genera-ambiente": "tsx ../../scripts/genera-ambiente-web.ts",
    "prestart": "npm run genera-ambiente",
    "start": "ng serve",
    "prebuild": "npm run genera-ambiente",
    "build": "ng build",
    "build:deploy": "tsx ../../scripts/genera-ambiente-web.ts --deploy && ng build",
    "pretest": "npm run genera-ambiente",
    "test": "ng test --watch=false",
    "pretypecheck": "npm run genera-ambiente",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^13.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
