# Copia questo file in .env solo sulla propria macchina, quando serve un progetto Firebase reale.
# .env non va mai in git. Per lo sviluppo con gli emulatori non serve nessun .env.
#
# Meccanismo: Angular non legge i file .env. Lo script scripts/genera-ambiente-web.ts
# legge .env (se esiste) e le variabili d'ambiente del processo (che hanno la precedenza)
# e scrive apps/web/src/environments/environment.ts, file generato e ignorato da git.
# Lo script gira prima di start, build, typecheck e test (pre-script in apps/web/package.json).

# Configurazione dell'app web Firebase (identificativi del progetto, non segreti di server).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# false (predefinito): l'app usa il progetto reale indicato sopra.
# true: l'app si collega agli emulatori locali (127.0.0.1) e usa il progetto demo-turni.
USE_EMULATORS=false

# Mesi modificabili dal coordinatore. Vuoto: 2 in produzione, 24 con gli emulatori.
FINESTRA_MESI_MODIFICABILI=

# Funzioni (dipendenti): niente di quanto segue va in questo file.
# - Emulatore: nessuna configurazione. functions/.env.local (versionato) dà un valore segnaposto a
#   KMS_CHIAVE_DIPENDENTI; la cifratura è quella locale non sicura e la chiave HMAC è una chiave di prova.
#   Se si vuole una chiave HMAC propria sull'emulatore: functions/.secret.local con una riga
#   HMAC_CF_CHIAVE=<almeno 32 caratteri> (il file è ignorato da git).
# - Produzione: KMS_CHIAVE_DIPENDENTI in functions/.env.<progetto> (nome completo della chiave in europe-west12)
#   e il secret HMAC_CF_CHIAVE in Secret Manager (vedi docs/ARCHITETTURA.md §12).
