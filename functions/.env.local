# Parametri delle Functions per l'emulatore (nessun segreto). L'emulatore legge questo file e non chiede i valori;
# al deploy non viene usato: i valori veri si danno nel file .env.<progetto> o al prompt della CLI.
# Cifratura e chiave HMAC dei dipendenti: sull'emulatore si usano le implementazioni locali non sicure.
KMS_CHIAVE_DIPENDENTI=non-usata-sull-emulatore
# Mittente delle email del report: vuoto = quello configurato nell'estensione Trigger Email (D12).
POSTA_MITTENTE=
