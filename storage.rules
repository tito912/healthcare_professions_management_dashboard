rules_version = '2';

// Il browser non accede mai a Storage (ARCHITETTURA §7): i file dei report li scrivono e leggono solo
// le Functions con l'Admin SDK, e il download passa dalla risposta della callable.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
